# stdio honesty — tcltest suite.
#
# stdin is a surftcl channel (installed by SurfTcl_InstallStdChannel
# before anything could acquire the Emscripten fd-0 device), so the same
# contract as any surftcl channel applies: empty-but-open is blocked,
# never EOF; close() from the page means EOF only after the queue drains;
# and readable fileevents are delivered through the queued-notify path.
#
# Runs identically headless and in the browser; needs the host-granted
# `eval` to reach the Runtime facade (this.stdin). Order matters: the
# close() tests are last because closing the page side of stdin is
# permanent for the session — there is no reopen, only a page reload.

package require tcltest
namespace import ::tcltest::*

proc js {code} { ::surftcl::js::call eval $code }

test stdio-stdin-1.1 {queued data reads back} -body {
    js {this.stdin.write("hello line\n")}
    gets stdin
} -result {hello line}

test stdio-stdin-1.2 {empty-but-open stdin: gets reports blocked, not eof} -body {
    set n [gets stdin line]
    list $n $line [fblocked stdin] [eof stdin]
} -result {-1 {} 1 0}

test stdio-stdin-1.3 {read on empty-but-open stdin returns nothing, still not eof} -body {
    list [read stdin 16] [eof stdin]
} -result {{} 0}

test stdio-stdin-2.1 {fileevent readable on stdin fires when the loop is pumped} -body {
    # The fd-0 device could never do this: its watch requests landed in
    # the notifier's no-op file-handler stubs. As a surftcl channel,
    # stdin delivers readability through the queued-event path, and
    # `update` pumps it.
    set ::stdinGot ""
    fileevent stdin readable {append ::stdinGot [gets stdin]}
    js {this.stdin.write("wake\n")}
    update
    fileevent stdin readable {}
    set ::stdinGot
} -cleanup {
    unset -nocomplain ::stdinGot
} -result wake

test stdio-stdin-3.1 {close drains queued bytes first} -body {
    # A short non-blocking read reports blocked and stops at the available
    # bytes; EOF is observed by the NEXT read. Standard Tcl channel
    # semantics — pinned here so nobody "fixes" it into lying early.
    js {this.stdin.write("last words"); this.stdin.close()}
    list [read stdin 32] [eof stdin]
} -result {{last words} 0}

test stdio-stdin-3.2 {the next read observes EOF} -body {
    list [read stdin 32] [eof stdin]
} -result {{} 1}

test stdio-stdin-3.3 {closed and drained stdin stays EOF} -body {
    list [gets stdin line] [eof stdin]
} -result {-1 1}

test stdio-stdin-3.4 {writing after close raises through the bridge} -body {
    catch {js {this.stdin.write("nope")}} msg
    set msg
} -match glob -result {*channel closed: stdin*}
