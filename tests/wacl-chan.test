# surftcl::chan — tcltest suite.
#
# Covers the C-core channel (opt/surftclChan.c): open/names, the
# BADNAME/EXISTS guards, close bookkeeping on both sides, the byte
# round-trip in both directions (JS->Tcl via `chan read`, Tcl->JS via
# `onData`), EOF-after-drain semantics for a JS-side close, and readable-
# fileevent delivery through the real path — the C core queues the notify
# event when JS writes, and `update` pumps it.
#
# On `vwait`: it can't be used here. On the main thread a blocking `vwait`
# can't yield to the JS loop that would produce the event, so it raises
# `TCL EVENT NO_SOURCES` at once (see opt/surftclNotifier.c). Tests pump
# with `update` instead.
#
# This suite runs identically headless and in the browser — the channel
# needs no DOM. The `js` helper needs the host-granted `eval` to reach
# Runtime.chan; the channel itself needs no grant.

package require tcltest
package require surftcl::chan
namespace import ::tcltest::*

# Thin helper: evaluate a JS snippet through the host-granted bridge.
proc js {script} { ::surftcl::js::call eval $script }

# ----- open / names -----
test chan-open-1.1 {open registers the name} -body {
    set ch [surftcl::chan open c1]
    expr {"c1" in [surftcl::chan names]}
} -cleanup {
    close $ch
} -result 1

test chan-open-1.2 {open returns a live Tcl channel} -body {
    set ch [surftcl::chan open c2]
    expr {$ch in [chan names]}
} -cleanup {
    close $ch
} -result 1

test chan-open-1.3 {channel comes configured non-blocking, unbuffered} -body {
    set ch [surftcl::chan open c3]
    list [fconfigure $ch -blocking] [fconfigure $ch -buffering]
} -cleanup {
    close $ch
} -result {0 none}

test chan-open-1.4 {the JS side sees the name too} -body {
    set ch [surftcl::chan open c4]
    js {String(this.chan.names().indexOf("c4") >= 0)}
} -cleanup {
    close $ch
} -result true

test chan-names-1.1 {names lists every open channel, stdin included} -body {
    # stdin appears because it IS a surftcl channel — the C side installs
    # it at boot (SurfTcl_InstallStdChannel).
    set a [surftcl::chan open n1]
    set b [surftcl::chan open n2]
    lsort [surftcl::chan names]
} -cleanup {
    close $a
    close $b
} -result {n1 n2 stdin}

test chan-open-2.1 {double open throws SURFTCL CHAN EXISTS} -setup {
    set ch [surftcl::chan open dup]
} -body {
    surftcl::chan open dup
} -cleanup {
    close $ch
} -returnCodes error -errorCode {SURFTCL CHAN EXISTS} \
  -match glob -result {channel already open:*}

test chan-open-2.2 {names outside [A-Za-z0-9_-] are rejected} -body {
    surftcl::chan open "no spaces"
} -returnCodes error -errorCode {SURFTCL CHAN BADNAME} \
  -match glob -result {bad channel name*}

# ----- close bookkeeping -----
test chan-close-1.1 {close drops the name from the Tcl registry} -body {
    set ch [surftcl::chan open x1]
    close $ch
    expr {"x1" in [surftcl::chan names]}
} -result 0

test chan-close-1.2 {close drops the name from the JS registry} -body {
    set ch [surftcl::chan open x2]
    close $ch
    js {String(this.chan.names().indexOf("x2") >= 0)}
} -result false

test chan-close-2.1 {a JS write to a Tcl-closed channel throws JS-side} -setup {
    set ch [surftcl::chan open x3]
    js {globalThis.__a = this.chan.attach("x3"); "ok"}
} -body {
    close $ch
    js {
        try { __a.write("nope"); "no-throw" }
        catch (e) { "threw: " + e.message }
    }
} -cleanup {
    js {delete globalThis.__a; "ok"}
} -match glob -result {threw: channel closed:*}

# ----- attach errors -----
test chan-attach-1.1 {attach to an unknown name throws JS-side} -body {
    js {
        try { this.chan.attach("nope"); "no-throw" }
        catch (e) { "threw: " + e.message }
    }
} -match glob -result {threw: *no such channel: nope}

# ----- JS -> Tcl: js write, tcl read -----
test chan-j2t-1.1 {a JS write is drained by a Tcl read} -setup {
    set ch [surftcl::chan open d1]
    js {globalThis.__a = this.chan.attach("d1"); "ok"}
} -body {
    js {__a.write("hello"); "ok"}
    chan read $ch 5
} -cleanup {
    close $ch
    js {delete globalThis.__a; "ok"}
} -result hello

test chan-j2t-1.2 {an empty channel reads as the empty string} -setup {
    set ch [surftcl::chan open d2]
} -body {
    chan read $ch 16
} -cleanup {
    close $ch
} -result {}

test chan-j2t-1.3 {a partial read leaves the remainder buffered} -setup {
    set ch [surftcl::chan open d3]
    js {globalThis.__a = this.chan.attach("d3"); "ok"}
} -body {
    js {__a.write("abcdef"); "ok"}
    set first  [chan read $ch 2]
    set second [chan read $ch 4]
    list $first $second
} -cleanup {
    close $ch
    js {delete globalThis.__a; "ok"}
} -result {ab cdef}

test chan-j2t-2.1 {bytes 1..255 round-trip with full fidelity} -setup {
    set ch [surftcl::chan open d4]
    js {globalThis.__a = this.chan.attach("d4"); "ok"}
} -body {
    js {var arr = []; for (var i = 1; i < 256; i++) arr.push(i);
        __a.write(new Uint8Array(arr)); "ok"}
    set data [chan read $ch 255]
    binary scan $data cu* got
    set want {}
    for {set i 1} {$i < 256} {incr i} { lappend want $i }
    list [string length $data] [expr {$got eq $want}]
} -cleanup {
    close $ch
    js {delete globalThis.__a; "ok"}
} -result {255 1}

test chan-j2t-2.2 {NUL crosses the boundary intact — the channel is byte-clean} -setup {
    set ch [surftcl::chan open d5]
    js {globalThis.__a = this.chan.attach("d5"); "ok"}
} -body {
    # Bytes cross as pointer+length, so NUL is just another byte. The old
    # string bridge truncated [65,0,66] to "A" here; this pins the
    # byte-clean contract of the C core as the tested fact instead.
    js {__a.write(new Uint8Array([65, 0, 66])); "ok"}
    set data [chan read $ch 10]
    binary scan $data cu* got
    list [string length $data] $got
} -cleanup {
    close $ch
    js {delete globalThis.__a; "ok"}
} -result {3 {65 0 66}}

test chan-j2t-3.1 {a JS close means EOF only after the queue drains} -setup {
    set ch [surftcl::chan open d6]
    js {globalThis.__a = this.chan.attach("d6"); "ok"}
} -body {
    js {__a.write("tail"); __a.close(); "ok"}
    set data [read $ch 4]
    set atEof [eof $ch]
    set more [read $ch 4]
    list $data $atEof $more [eof $ch]
} -cleanup {
    close $ch
    js {delete globalThis.__a; "ok"}
} -result {tail 0 {} 1}

# ----- Tcl -> JS: tcl write, js onData -----
test chan-t2j-1.1 {a Tcl write reaches the JS onData callback} -setup {
    set ch [surftcl::chan open w1]
    js {globalThis.__a = this.chan.attach("w1");
        globalThis.__got = null;
        __a.onData = function (b) {
            globalThis.__got = Array.prototype.join.call(b, ",");
        };
        "ok"}
} -body {
    puts -nonewline $ch AB
    flush $ch
    js {String(globalThis.__got)}
} -cleanup {
    close $ch
    js {delete globalThis.__a; delete globalThis.__got; "ok"}
} -result 65,66

test chan-t2j-2.1 {high bytes survive the Tcl->JS direction too} -setup {
    set ch [surftcl::chan open w2]
    js {globalThis.__a = this.chan.attach("w2");
        globalThis.__sum = 0;
        __a.onData = function (b) {
            for (var i = 0; i < b.length; i++) globalThis.__sum += b[i];
        };
        "ok"}
} -body {
    set payload {}
    for {set i 1} {$i < 256} {incr i} { append payload [binary format c $i] }
    puts -nonewline $ch $payload
    flush $ch
    # 1 + 2 + ... + 255 = 32640. A faithful byte path lands exactly here.
    js {String(globalThis.__sum)}
} -cleanup {
    close $ch
    js {delete globalThis.__a; delete globalThis.__sum; "ok"}
} -result 32640

# ----- readable fileevent delivery, pumped by `update` -----
test chan-fileevent-1.1 {JS-fed bytes dispatch a readable fileevent when the loop is pumped} -setup {
    set ch [surftcl::chan open f1]
    js {globalThis.__a = this.chan.attach("f1"); "ok"}
} -body {
    # The real delivery path, end to end: the C core queues the readable
    # notification when JS writes (Tcl_QueueEvent -> Tcl_NotifyChannel),
    # and `update` pumps it — no manual chan postevent. (The old scripted
    # channel could only test dispatch by posting the event itself; its
    # actual JS->Tcl delivery relied on setTimeout callbacks with broken
    # `this` bindings and never worked.) No `vwait` — it can't work on
    # the main thread.
    set ::got ""
    fileevent $ch readable {append ::got [read $ch]}
    js {__a.write("ping"); "ok"}
    update
    set ::got
} -cleanup {
    close $ch
    js {delete globalThis.__a; "ok"}
} -result ping
